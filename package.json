{
  "name": "context-reader",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "app",
    "server",
    "packages/*"
  ],
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "expo": "~57.0.21",
    "expo-font": "~57.0.3",
    "test-renderer": "1.1.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@context-reader/server",
    "dev:app": "npm run start --workspace=app",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "check": "npm run typecheck && npm run test && npm run lint",
    "audio:r2:inventory": "node scripts/upload-economist-2026-r2.mjs",
    "audio:r2:upload": "node scripts/upload-economist-2026-r2.mjs --upload",
    "cloudflare:deploy:audio": "wrangler deploy --config cloudflare/audio/wrangler.jsonc",
    "cloudflare:deploy:images": "wrangler deploy --config cloudflare/images/wrangler.jsonc",
    "cloudflare:prepare:web": "node scripts/prepare-cloudflare-web.mjs",
    "cloudflare:deploy:web": "wrangler deploy --config cloudflare/web/wrangler.jsonc"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1139.0",
    "react-native-web": "0.21.2",
    "test-renderer": "1.1.0",
    "wrangler": "4.138.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "esbuild@0.27.7": true,
    "unrs-resolver@1.12.2": true
  }
}
