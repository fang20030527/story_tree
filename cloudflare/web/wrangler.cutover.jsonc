{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "waikan-web",
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,
  "routes": [
    { "pattern": "blackholeenglish.com", "custom_domain": true }
  ],
  "services": [
    { "binding": "API_SERVICE", "service": "waikan-api" },
    { "binding": "AUDIO_SERVICE", "service": "waikan-audio" }
  ],
  "assets": {
    "directory": "../../app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
