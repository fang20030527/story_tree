{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "waikan-web",
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-24",
  "services": [
    { "binding": "API_SERVICE", "service": "waikan-api" }
  ],
  "assets": {
    "directory": "../../app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/_expo/static/js/web/entry-*.js", "/v1/*", "/computer-upload*"]
  }
}
