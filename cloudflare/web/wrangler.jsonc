{
  "name": "waikan-web",
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-24",
  "vars": {
    "API_ORIGIN": "https://waikan-api.onrender.com"
  },
  "assets": {
    "directory": "../../app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/_expo/static/js/web/entry-*.js", "/v1/*"]
  }
}
