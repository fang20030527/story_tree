+  /**
+   * Runs a mutation requested from JavaScript on the main thread, skipping it once the player has been released.
+   * AVKit's `AVPlayerController` (backing `VideoView`) observes the `AVPlayer` with KVO on the main thread, so
+   * mutating the player from the JS thread races with those observers and can crash with `EXC_BAD_ACCESS`.
+   */
+  func runOnMainThreadIfNotReleased(_ operation: @escaping (VideoPlayer) -> Void) {
+    runOnMainThread { [weak self] in
+      guard let self, !self.hasBeenReleased else {
+        return
+      }
+      operation(self)
+    }
+  }
