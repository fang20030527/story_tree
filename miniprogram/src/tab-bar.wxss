.bar{position:fixed;bottom:0;left:0;right:0;display:flex;justify-content:space-around;background:#FBFAF6;border-top:1rpx solid #DDDCCF;padding:12rpx 20rpx calc(12rpx + env(safe-area-inset-bottom));color:#6E7366}.bar.dark{background:#191B17;border-color:#43483D;color:#ADB1A1}.tab{flex:1;display:flex;flex-direction:column;align-items:center;gap:10rpx;padding:14rpx 0 6rpx;background:transparent;color:inherit;border-radius:0;font-size:21rpx;line-height:1.5;min-height:96rpx}.tab::after{border:0}.active{color:#B53720}.dark .active{color:#F28F74}.icon{width:36rpx;height:36rpx;position:relative;box-sizing:border-box}.icon-home{border:2rpx solid currentColor;border-radius:2rpx}.icon-home .first{position:absolute;left:6rpx;top:6rpx;width:9rpx;height:9rpx;border:1.5rpx solid currentColor}.icon-home .second,.icon-home .third{position:absolute;left:6rpx;right:6rpx;height:2rpx;background:currentColor;top:23rpx}.icon-home .third{top:29rpx}.icon-shelf .stroke{position:absolute;bottom:0;border:2rpx solid currentColor;width:9rpx;height:33rpx;left:0}.icon-shelf .second{left:13rpx;height:29rpx}.icon-shelf .third{left:26rpx;transform:rotate(-10deg)}.icon-words{border:2rpx solid currentColor;top:7rpx;height:27rpx;border-radius:2rpx}.icon-words .first,.icon-words .second{position:absolute;left:2rpx;right:2rpx;top:-7rpx;border-top:2rpx solid currentColor}.icon-words .second{left:5rpx;right:5rpx;top:-12rpx}.icon-profile .first{position:absolute;top:0;left:10rpx;width:17rpx;height:17rpx;border:2rpx solid currentColor;border-radius:50%;box-sizing:border-box}.icon-profile .second{position:absolute;bottom:0;left:1rpx;width:34rpx;height:17rpx;border:2rpx solid currentColor;border-radius:19rpx 19rpx 0 0;box-sizing:border-box}
