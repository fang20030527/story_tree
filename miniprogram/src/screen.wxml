<view class="screen {{dark ? 'dark' : ''}} {{kind === 'home' || kind === 'shelf' || kind === 'words' || kind === 'profile' ? 'tab-page' : ''}}">
  <view wx:if="{{kind === 'home' || kind === 'shelf' || kind === 'words' || kind === 'profile'}}" class="brand" style="padding-top:{{statusTop}}px"><image class="logo" src="/assets/logo.png" mode="aspectFill" aria-label="黑洞英语" /></view>
  <view class="content">
    <view wx:if="{{kind === 'home'}}">
      <view class="page-heading"><text class="heading">外刊</text><text class="muted">读英语，也读世界。</text></view>
      <view wx:if="{{hero}}" class="hero pink" hover-class="pressed" hover-start-time="0" hover-stay-time="120" bindtap="openArticle" data-id="{{hero.id}}">
        <text class="eyebrow">每日精选</text><text class="hero-title serif">{{hero.titleEn}}</text>
        <image class="hero-image" src="{{hero.image}}" mode="aspectFill" />
        <view class="hero-meta"><text>{{hero.source}}</text><text>{{hero.minutes}} 分钟</text><text class="round-arrow">→</text></view>
        <text class="hero-zh">{{hero.titleZh}}</text><view class="hero-bottom"><text>{{hero.category}}</text><text>{{hero.wordCount}} 词</text></view>
      </view>
      <view class="section-heading"><text>发现文章</text><text class="muted small">{{total}} 篇</text></view>
      <view class="filter-row"><text class="filter-label">主题</text><scroll-view scroll-x class="filters"><button wx:for="{{topics}}" wx:key="*this" class="chip {{topic === item ? 'selected' : ''}}" bindtap="filter" data-field="topic" data-value="{{item}}">{{item}}</button></scroll-view></view>
      <view class="filter-row"><text class="filter-label">外刊</text><scroll-view scroll-x class="filters"><button wx:for="{{publications}}" wx:key="*this" class="chip {{publication === item ? 'selected' : ''}}" bindtap="filter" data-field="publication" data-value="{{item}}">{{item}}</button></scroll-view></view>
      <input class="input search" placeholder="搜索文章、标题或外刊" value="{{query}}" bindinput="input" data-field="query" aria-label="搜索文章" />
      <view wx:for="{{articles}}" wx:key="id" class="article-row" bindtap="openArticle" data-id="{{item.id}}" hover-class="pressed">
        <image class="cover" src="{{item.image}}" mode="aspectFill" /><view class="row-info"><text>{{item.titleZh}}</text><text class="muted small">{{item.source}} · {{item.minutes}} 分钟</text><text class="muted small">{{item.category}} · {{item.level}}</text></view><text class="muted">›</text>
      </view>
      <text wx:if="{{!loading &amp;&amp; !articles.length &amp;&amp; !error}}" class="empty">当前筛选暂无文章，试试其他主题或外刊。</text>
      <button wx:if="{{articles.length &lt; total}}" class="text-button" bindtap="more">加载更多文章</button>
    </view>
    <view wx:if="{{kind === 'shelf'}}">
      <view class="page-heading"><text class="heading">书架</text><button class="text-button action" bindtap="go" data-page="import">导入</button></view>
      <text class="muted intro">把喜欢的，慢慢读完。</text>
      <view class="tabs"><button wx:for="{{['全部', '外刊', '导入']}}" wx:key="*this" class="chip {{shelfFilter === item ? 'selected' : ''}}" bindtap="filter" data-field="shelfFilter" data-value="{{item}}">{{item}}</button></view>
      <view wx:if="{{rows.length}}" class="shelf-feature pink" hover-class="pressed" bindtap="openRow" data-id="{{rows[0].id}}" data-source="{{rows[0].source}}"><text class="eyebrow">从这里继续</text><text class="serif shelf-title">{{rows[0].title}}</text><view class="hero-bottom"><text>打开文章</text><text>→</text></view></view>
      <view wx:for="{{rows}}" wx:key="id" class="article-row" bindtap="openRow" data-id="{{item.id}}" data-source="{{item.source}}"><image wx:if="{{item.image}}" class="cover" src="{{item.image}}" mode="aspectFill" /><view wx:else class="cover cover-placeholder serif">Read.</view><view class="row-info"><text>{{item.title}}</text><text class="small muted">{{item.subtitle}}</text></view><text>›</text></view>
      <view wx:if="{{!loading &amp;&amp; !rows.length}}" class="empty"><text>你的书架，等一本喜欢的文章。</text><button class="text-button" bindtap="go" data-page="home">浏览外刊 →</button><button class="text-button" bindtap="go" data-page="import">导入自己的文章 →</button></view>
      <button wx:if="{{cursor}}" class="text-button" bindtap="more" disabled="{{busy}}">加载更多</button>
    </view>
    <view wx:if="{{kind === 'words'}}">
      <view class="page-heading"><text class="heading">词库</text><text class="muted">每个词，都有下次见面。</text></view>
      <view class="review" hover-class="pressed" hover-start-time="0" hover-stay-time="120" bindtap="go" data-page="practice"><text class="eyebrow">今天，和这些词再见一面</text><view class="review-number"><text class="serif">{{due}}</text><text>词待复习</text></view><text>在一篇新文章里，把它们读懂。</text><view class="hero-bottom"><text>开始今天的练习</text><text>→</text></view></view>
      <view class="stats"><view wx:for="{{['全部单词', '正在学习', '已经掌握']}}" wx:key="*this"><text class="stat-value serif">{{stats[index]}}</text><text class="muted small">{{item}}</text></view></view>
      <view class="section-heading"><text>我的生词本</text><button class="text-button" bindtap="go" data-page="vocabulary">查看全部</button></view>
      <view class="article-row" bindtap="go" data-page="vocabulary"><view class="word-cover serif">Words
in
context.</view><view class="row-info"><text>阅读中遇见的词</text><text class="muted small">{{stats[0]}} 个单词 · 今天新增 {{added}} 个</text><text class="accent small">打开生词本 →</text></view></view>
      <button wx:if="{{message}}" class="primary" bindtap="enable" disabled="{{busy}}">启用云端学习</button>
    </view>
    <view wx:if="{{kind === 'profile'}}">
      <view class="page-heading"><text class="heading">我的</text><button class="text-button action ink" bindtap="go" data-page="settings">⚙ 设置</button></view>
      <view class="identity"><view class="avatar">人</view><view class="row-info"><text>{{loggedIn ? email : '未登录'}}</text><text class="small muted">{{loggedIn ? '继续积累，继续阅读。' : '登录后同步阅读记录与词库'}}</text></view><button wx:if="{{!loggedIn}}" class="text-button" bindtap="go" data-page="login">去登录 ›</button></view>
      <view class="vip-entry" hover-class="pressed" bindtap="go" data-page="vip"><view><text>升级为 VIP 版</text><text class="small">解锁全部功能</text></view><text class="vip-cta">立即开通 →</text></view>
      <text class="muted section-label">学习记录</text><view class="stats"><view wx:for="{{['近期阅读', '词库单词', '已掌握']}}" wx:key="*this"><text class="stat-value serif">{{stats[index]}}</text><text class="small muted">{{item}}</text></view></view>
      <view class="study"><view class="section-heading"><text>学习日志</text><text class="muted small">累计 {{studyDays}} 天有学习</text></view><text class="muted small">近 13 周 · 当前账号在本机的阅读时长</text><view class="heatmap"><view class="week" wx:for="{{weeks}}" wx:key="week" wx:for-item="week"><button wx:for="{{week.days}}" wx:key="key" class="day level-{{item.level}} {{item.today ? 'today' : ''}} {{item.future ? 'future' : ''}} {{selectedDate === item.key ? 'active-day' : ''}}" disabled="{{item.future}}" bindtap="day" data-key="{{item.key}}" aria-label="{{item.key}}，学习 {{item.minutes}} 分钟" /></view></view><view class="legend"><text>每天 10 分钟，慢慢积累。</text><text>少</text><view class="level-0" /><view class="level-1" /><view class="level-2" /><view class="level-3" /><view class="level-4" /><text>多</text></view><text class="small muted">{{selectedDate}} · 学习 {{selectedMinutes}} 分钟</text></view>
      <text class="muted section-label">我的内容</text><view class="profile-shortcuts"><button bindtap="go" data-page="recent"><text class="accent">◷</text> 最近阅读</button><button bindtap="go" data-page="shelf"><text class="accent">♧</text> 我的收藏</button></view>
      <button class="menu" bindtap="go" data-page="practice"><text>阅读练习</text><text class="muted">换个语境练习 ›</text></button><button class="menu" bindtap="go" data-page="import"><text>导入文章</text><text class="muted">添加阅读材料 ›</text></button><button class="menu" bindtap="go" data-page="guide"><text>功能指南</text><text>›</text></button>
    </view>
    <view wx:if="{{kind === 'article'}}">
      <image wx:if="{{image}}" class="overview-image" src="{{image}}" mode="aspectFill" /><text class="muted small">{{meta}}</text><text class="display serif">{{title}}</text><text class="title-zh">{{titleZh}}</text><text class="section-label">读这篇，你会了解</text><text class="body-zh">{{summary}}</text><view wx:for="{{keyPoints}}" wx:key="*this" class="key-point"><text class="accent">{{index + 1}}.</text><text>{{item}}</text></view><button wx:if="{{article}}" class="primary" bindtap="read">开始阅读 →</button><button wx:if="{{source === 'editorial' &amp;&amp; article}}" class="text-button" bindtap="bookmark">{{bookmarked ? '已加入书架 · 点击移除' : '收藏到书架'}}</button>
    </view>
    <view wx:if="{{kind === 'reader'}}">
      <text class="muted small">{{meta}}</text><text class="display serif">{{title}}</text><text wx:if="{{titleZh}}" class="title-zh">{{titleZh}}</text>
      <view class="reader-tools"><button wx:if="{{hasAudio}}" class="chip" bindtap="audio">{{playing ? '暂停朗读' : '原刊朗读'}}</button><button class="chip" bindtap="translate" disabled="{{busy || translationPending}}">{{translationPending ? '翻译中…' : '全文翻译'}}</button><button wx:if="{{source === 'practice'}}" class="chip" bindtap="quiz">语境自测 →</button></view>
      <view wx:if="{{translated}}" class="translation body-zh">{{translated}}</view>
      <view wx:for="{{paragraphs}}" wx:key="id" wx:for-item="paragraph" wx:for-index="paragraphIndex"><view class="paragraph"><text wx:for="{{paragraph.tokens}}" wx:key="index" decode wx:for-item="token" bindtap="lookupWord" data-term="{{token.term}}" data-paragraph="{{paragraphIndex}}" class="{{lookupTerm === token.term ? 'highlight' : ''}}">{{token.text}}</text></view><view wx:for="{{figures}}" wx:key="url" wx:for-item="figure" wx:if="{{figure.after === paragraphIndex}}"><image wx:if="{{!figure.video}}" class="reader-figure" src="{{figure.url}}" mode="widthFix" /><video wx:elif="{{figure.direct}}" class="reader-figure" src="{{figure.url}}" /><text wx:else class="small muted">此视频需在原网页播放。</text><text wx:if="{{figure.caption}}" class="small muted">{{figure.caption}}</text></view></view>
      <button wx:if="{{source === 'practice' &amp;&amp; paragraphs.length}}" class="primary" bindtap="quiz">开始语境自测 →</button>
    </view>
    <view wx:if="{{kind === 'vocabulary'}}">
      <text class="display">我的生词本</text><view class="tabs"><button wx:for="{{[{id:'all',label:'全部'},{id:'due',label:'待复习'},{id:'scheduled',label:'未到时间'}]}}" wx:key="id" class="chip {{wordFilter === item.id ? 'selected' : ''}}" bindtap="filter" data-field="wordFilter" data-value="{{item.id}}">{{item.label}}</button></view>
      <view wx:for="{{words}}" wx:key="wordId" class="word-row"><view class="row-info"><text class="word serif">{{item.term}}</text><text>{{item.meaningZh}}</text><text wx:if="{{item.sourceSentence}}" class="small muted">{{item.sourceSentence}}</text><text class="small muted">{{item.masteredAt ? '已掌握' : item.nextReviewAt ? '下一次复习：' + item.nextReviewAt : '尚未练习'}}</text></view><button wx:if="{{!item.masteredAt}}" class="text-button" bindtap="mastered" data-id="{{item.wordId}}" disabled="{{busy}}">已掌握</button></view>
      <button wx:if="{{!words.length &amp;&amp; !loading &amp;&amp; message}}" class="primary" bindtap="enable">启用云端学习</button><text wx:if="{{!words.length &amp;&amp; !loading &amp;&amp; !message &amp;&amp; !error}}" class="empty">这里还没有单词，先去读一篇文章吧。</text><button wx:if="{{cursor}}" class="text-button" bindtap="more" disabled="{{busy}}">加载更多单词</button><button class="primary" bindtap="go" data-page="practice">用这些词，读一篇新文章 →</button>
    </view>
    <view wx:if="{{kind === 'practice'}}">
      <text class="eyebrow accent">WORDS INTO STORIES</text><text class="display">把单词，
放回<text class="accent">文章里。</text></text><text class="muted intro">换一个语境，让记忆多一个落点。</text>
      <view class="count"><text>这次想练多少词？</text><button class="counter" bindtap="count" data-delta="-1" disabled="{{targetCount === 1}}">−</button><text class="serif">{{targetCount}}</text><button class="counter" bindtap="count" data-delta="1" disabled="{{targetCount === 10}}">＋</button><text class="muted">词</text></view>
      <view class="mode-tabs"><button class="chip {{mode === 'smart' ? 'selected' : ''}}" bindtap="mode" data-value="smart">智能选词</button><button class="chip {{mode === 'custom' ? 'selected' : ''}}" bindtap="mode" data-value="custom">自定义选词</button></view>
      <text wx:if="{{mode === 'smart'}}" class="body-zh muted">根据你的记忆曲线，优先安排待复习单词。你只管读，选词交给我们。</text>
      <view wx:else><text class="muted intro">自己选择这次要练的单词（{{selected.length}}/10）。</text><view wx:for="{{words}}" wx:key="wordId" class="word-choice {{item.selected ? 'chosen' : ''}}" bindtap="selectWord" data-id="{{item.wordId}}"><view><text class="serif word">{{item.term}}</text><text class="muted small">{{item.meaningZh}}</text></view><text>{{item.selected ? '✓' : '＋'}}</text></view><button wx:if="{{cursor}}" class="text-button" bindtap="more">加载更多</button><view class="manual"><input class="input" placeholder="自己录入英文单词" bindinput="input" data-field="manualTerm" value="{{manualTerm}}" /><input class="input" placeholder="在这次练习中的中文释义" bindinput="input" data-field="manualMeaning" value="{{manualMeaning}}" /><button class="text-button" bindtap="addManual">加入选词</button><text wx:for="{{selected}}" wx:key="wordId" class="selected-word">{{item.term}}</text></view></view>
      <view class="practice-meta"><view><text class="serif">4</text><text class="muted small">不同主题</text></view><view><text class="serif">200–300</text><text class="muted small">每篇英文词数</text></view></view><text class="small muted intro">{{quota}}</text><button class="primary" bindtap="createPractice" loading="{{busy}}" disabled="{{busy || (mode === 'custom' &amp;&amp; !selected.length)}}">生成阅读练习 →</button><button wx:if="{{activePractice}}" class="text-button" bindtap="resume">继续上次的练习</button>
    </view>
    <view wx:if="{{kind === 'generating'}}" class="generating"><text class="serif display">A new context.</text><text class="title-zh">正在准备你的阅读练习</text><text class="muted body-zh">{{message}}</text><text class="small muted">可以离开页面，稍后从阅读练习继续查看。</text><button class="text-button" bindtap="go" data-page="profile">返回我的</button></view>
    <view wx:if="{{kind === 'topics'}}"><text class="display">四篇短文，
四个新语境。</text><view wx:for="{{practice.group.articles}}" wx:key="id" class="topic-card" bindtap="openTopic" data-id="{{item.id}}"><text class="eyebrow accent">{{item.topic}}</text><text class="serif topic-title">{{item.title || '正在准备文章…'}}</text><text class="muted small">{{item.status === 'completed' ? '已完成' : item.status === 'ready' || item.status === 'in_progress' ? '开始阅读 →' : item.status === 'failed' ? item.failureMessage : '生成中，请稍候'}}</text></view><button wx:if="{{practice.group.canRetryFailed}}" class="text-button" bindtap="retryTopics" disabled="{{busy}}">重试失败的短文</button></view>
    <view wx:if="{{kind === 'quiz' &amp;&amp; question}}"><text class="muted small">语境自测 · {{questionIndex + 1}} / {{questionsTotal}}</text><text class="display serif">{{question.term}}</text><text class="body-zh">{{question.prompt}}</text><button wx:for="{{question.options}}" wx:key="id" class="option {{selectedOption === item.id ? 'chosen' : ''}} {{feedback &amp;&amp; feedback.correctOptionId === item.id ? 'correct' : ''}}" bindtap="option" data-id="{{item.id}}" disabled="{{busy || !!feedback}}">{{item.label}}</button><view wx:if="{{feedback}}" class="feedback"><text class="title-zh">{{feedback.isCorrect ? '答对了' : '这一次，记住它'}}</text><text class="body-zh">{{feedback.meaningEn}}</text><text class="body-zh">{{feedback.explanationZh}}</text><text wx:if="{{feedback.wasAssisted}}" class="muted small">本题使用过辅助，将按辅助练习记录。</text><button class="primary" bindtap="nextQuestion">{{questionIndex + 1 === questionsTotal ? '查看学习结果' : '下一题 →'}}</button></view><view wx:else><button class="primary" bindtap="answer" disabled="{{busy || !selectedOption}}" loading="{{busy}}">确认答案</button><button class="text-button" bindtap="answer" data-kind="dont_know" disabled="{{busy}}">暂时不知道</button></view></view>
    <view wx:if="{{kind === 'result'}}"><text class="eyebrow accent">ONE MORE STEP</text><text class="display">又读懂了一点。</text><view class="result-score"><text class="serif">{{correct}} / {{questionsTotal}}</text><text class="muted">正确回答</text></view><text class="body-zh">复习安排已根据本次实际作答更新。下次再见，会更熟悉一点。</text><button class="primary" bindtap="go" data-page="words">回到词库 →</button></view>
    <view wx:if="{{kind === 'import'}}">
      <text class="display">把想读的，
带进来。</text><text class="muted intro">链接、正文、文件或图片，都能成为阅读材料。</text>
      <view wx:if="{{!importId}}"><view class="tabs"><button wx:for="{{[{id:'url',label:'文章链接'},{id:'paste',label:'粘贴正文'}]}}" wx:key="id" class="chip {{importMode === item.id ? 'selected' : ''}}" bindtap="importMode" data-value="{{item.id}}">{{item.label}}</button></view><textarea class="textarea" auto-height maxlength="131072" value="{{input}}" bindinput="input" data-field="input" placeholder="{{importMode === 'paste' ? '粘贴 20–5,000 词的英文正文' : '粘贴公开文章的完整链接'}}" /><button class="primary" bindtap="importArticle" disabled="{{busy}}" loading="{{busy}}">整理文章 →</button><view class="import-options"><button class="menu" bindtap="file" data-kind="file" disabled="{{busy}}"><text>从微信选择文件</text><text>›</text></button><button class="menu" bindtap="file" data-kind="album" disabled="{{busy}}"><text>从相册选择图片</text><text>›</text></button><button class="menu" bindtap="computer" disabled="{{busy}}"><text>在电脑上传</text><text>›</text></button></view><text class="small muted">文件支持 PDF、TXT、Markdown、DOCX、EPUB；单文件上限 10 MiB，图片整批上限 30 MiB。</text></view>
      <view wx:else><text class="title-zh">{{importStatus === 'awaiting_upload' ? '等待上传材料' : importStatus === 'retryable' ? '可以重试本次导入' : '正在整理文章'}}</text><text class="muted body-zh">{{message}}</text><view wx:if="{{uploadCode}}" class="upload-code"><text>在电脑打开上传页面，输入：</text><text class="serif display">{{uploadCode}}</text><text class="small muted">10 分钟内有效，单次使用。</text><button class="text-button" bindtap="copyUpload">复制上传地址与上传码</button></view><button wx:if="{{importStatus === 'awaiting_upload' &amp;&amp; !uploadCode}}" class="text-button" bindtap="retryUpload" disabled="{{busy}}">重试上传</button><button wx:if="{{importStatus === 'retryable'}}" class="primary" bindtap="retryImport" disabled="{{busy}}">重试整理</button><button wx:if="{{error &amp;&amp; importStatus !== 'retryable'}}" class="text-button" bindtap="retry">查看最新状态</button><button class="text-button" bindtap="newImport" disabled="{{busy}}">开始另一次导入</button></view>
    </view>
    <view wx:if="{{kind === 'import-preview'}}"><text class="eyebrow accent">READY TO READ</text><text class="display">{{previewTitle}}</text><text wx:if="{{duplicate === 'exact'}}" class="body-zh muted">书架已有相同文章，确认后会打开原文章。</text><text wx:if="{{duplicate === 'similar'}}" class="body-zh muted">发现一篇相似文章，你可以打开已有文章，或保留这个新版本。</text><view class="preview body-zh">{{previewText}}</view><view wx:if="{{duplicate === 'similar'}}"><button class="primary" bindtap="confirmImport" data-decision="open_existing" disabled="{{busy}}">打开已有文章</button><button class="text-button" bindtap="confirmImport" data-decision="save_new_version" disabled="{{busy}}">保存新版本</button></view><button wx:else class="primary" bindtap="confirmImport" disabled="{{busy || importStatus !== 'preview_ready'}}" loading="{{busy}}">确认并开始阅读 →</button></view>
    <view wx:if="{{kind === 'login'}}"><image class="login-logo" src="/assets/logo.png" mode="aspectFill" /><text class="display">让积累，跟着你。</text><text class="muted body-zh">邮箱与密码登录；首次使用会自动创建账号。</text><input class="input" type="text" placeholder="邮箱" value="{{email}}" bindinput="input" data-field="email" aria-label="邮箱" /><input class="input" password placeholder="密码（至少 8 位）" value="{{password}}" bindinput="input" data-field="password" aria-label="密码" /><button class="primary" bindtap="login" disabled="{{busy || !email || !password}}" loading="{{busy}}">登录 / 创建账号 →</button><text class="small muted">邮箱用于同步账号，密码只发送给服务端验证，不保存在本机。</text></view>
    <view wx:if="{{kind === 'settings'}}"><text class="display">设置</text><button class="menu" bindtap="dark"><text>深色模式</text><text>{{dark ? '已开启' : '已关闭'}} ›</text></button><button class="menu" bindtap="go" data-page="login"><text>登录账号</text><text>›</text></button><button class="menu" bindtap="go" data-page="guide"><text>功能指南</text><text>›</text></button><button class="menu" bindtap="logout"><text class="accent">退出登录</text><text>›</text></button></view>
    <view wx:if="{{kind === 'vip'}}"><view class="vip-hero"><text class="eyebrow">黑洞英语 VIP</text><text class="display">解锁全部
<text class="vip-pink">阅读特权。</text></text><text class="small">让每一次阅读，都有所积累。</text></view><view class="section-heading"><text>为认真阅读的你</text></view><view wx:for="{{[{title:'智能陪练',description:'在新语境中，掌握自己的积累'},{title:'语境查词',description:'一点即懂，不用猜哪个释义'},{title:'长难句分析',description:'理解复杂句子的结构与含义'},{title:'专业语音朗读',description:'每篇文章，都能听着学'}]}}" wx:key="title" class="benefit"><text class="accent">✓</text><view class="row-info"><text>{{item.title}}</text><text class="muted small">{{item.description}}</text></view></view><text class="section-label muted">待上线方案预览</text><view class="plans"><button wx:for="{{[{id:'monthly',label:'月度',price:'19'},{id:'annual',label:'年度',price:'128'},{id:'lifetime',label:'永久',price:'198'}]}}" wx:key="id" class="plan {{plan === item.id ? 'chosen' : ''}}" bindtap="plan" data-value="{{item.id}}"><text>{{item.label}}</text><text class="serif">¥{{item.price}}</text></button></view><text class="small muted intro">价格与权益为拟定方案，以正式上线为准。</text><button class="primary" disabled>暂未开放开通</button><text class="small muted intro">支付服务尚未接入，不会扣费或开通会员。</text><button class="menu invite" bindtap="invite"><text>邀请码兑换</text><text>{{inviteOpen ? '⌃' : '›'}}</text></button><view wx:if="{{inviteOpen}}"><input class="input" disabled placeholder="兑换服务尚未开放" /><text class="small muted">暂不验证或保存邀请码。</text></view></view>
    <view wx:if="{{kind === 'guide'}}"><text class="display">读懂一点，
积累一点。</text><view class="guide-step"><text class="serif accent">01</text><text class="title-zh">先了解，再阅读</text><text class="body-zh muted">每日精选不会随主题或外刊筛选改变。点击整张卡片查看文章概述，再开始阅读全文。</text></view><view class="guide-step"><text class="serif accent">02</text><text class="title-zh">在语境中积累单词</text><text class="body-zh muted">点击英文单词查看当前语境释义，加入生词本。同一个词的不同释义共享复习安排。</text></view><view class="guide-step"><text class="serif accent">03</text><text class="title-zh">按记忆曲线复习</text><text class="body-zh muted">智能选词优先安排待复习单词。也可以自己选择单词。阅读短文后完成自测，让复习安排更适合你。</text></view><text class="muted small">学习日志记录当前账号在本机的阅读时长，暂不跨设备同步。VIP 支付与邀请码兑换尚未开放。</text></view>
    <view wx:if="{{kind === 'recent'}}"><text class="display">最近阅读</text><view wx:for="{{rows}}" wx:key="id" class="article-row" bindtap="openRow" data-id="{{item.id}}" data-source="{{item.source}}"><view class="row-info"><text>{{item.title}}</text><text class="muted small">{{item.subtitle}}</text></view><text>›</text></view><text wx:if="{{!rows.length}}" class="empty">读过的文章，会留在这里。</text></view>
    <view wx:if="{{loading}}" class="status muted">正在加载…</view><view wx:if="{{busy}}" class="status muted">正在处理，请稍候…</view>
    <view wx:if="{{error}}" class="error" role="alert"><text>{{error}}</text><button wx:if="{{kind !== 'login' &amp;&amp; kind !== 'quiz' &amp;&amp; kind !== 'import-preview'}}" class="text-button" bindtap="retry" disabled="{{busy}}">重新加载</button></view>
    <text wx:if="{{message &amp;&amp; kind !== 'generating' &amp;&amp; kind !== 'import'}}" class="small muted intro">{{message}}</text>
  </view>
  <view wx:if="{{lookupTerm}}" class="lookup"><view class="lookup-header"><text class="serif">{{lookupTerm}}</text><button class="text-button" bindtap="closeLookup">关闭</button></view><text wx:if="{{!lookup &amp;&amp; busy}}" class="small muted">正在查询语境释义…</text><view wx:if="{{lookup}}"><text class="small muted">{{lookup.partOfSpeech}}</text><text class="body-zh">{{lookup.meaningZh}}</text><button class="text-button" bindtap="addWord" disabled="{{wordAdded || busy}}">{{wordAdded ? '已加入生词本 ✓' : '加入生词本 ＋'}}</button></view></view>
</view>
