{
  "name": "@context-reader/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../app/.env --watch --import tsx src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=../app/.env --import tsx src/db/migrate.ts",
    "smoke:live": "node --env-file=../app/.env --import tsx scripts/live-smoke.ts"
  },
  "dependencies": {
    "@context-reader/contracts": "*",
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.3",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "tsx": "4.23.13",
    "tsup": "8.5.1",
    "typescript": "5.9.2",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
