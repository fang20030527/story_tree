{
  "name": "@context-reader/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../app/.env --watch --import tsx src/index.ts",
    "build": "npm run editorial:validate",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=../app/.env --import tsx src/db/migrate.ts",
    "db:migrate:production": "node dist/db/migrate.js",
    "smoke:live": "node --env-file=../app/.env --import tsx scripts/live-smoke.ts",
    "smoke:imports": "node --env-file=../app/.env --import tsx scripts/import-live-smoke.ts",
    "check:client-secrets": "node --env-file=../app/.env --import tsx scripts/check-client-secrets.ts",
    "editorial:validate": "tsup && node dist/scripts/validate-editorial.js"
  },
  "dependencies": {
    "@context-reader/contracts": "*",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/formbody": "8.0.2",
    "@fastify/multipart": "10.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@mozilla/readability": "0.6.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.3",
    "file-type": "22.0.2",
    "franc-min": "6.2.0",
    "heic-convert": "2.1.0",
    "ipaddr.js": "2.5.0",
    "linkedom": "0.18.13",
    "mammoth": "1.12.2",
    "pdf-parse": "2.4.5",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "sharp": "0.35.4",
    "ts-fsrs": "5.4.2",
    "undici": "7.29.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "fflate": "0.8.2",
    "pdf-lib": "1.17.1",
    "tsx": "4.23.13",
    "tsup": "8.5.1",
    "typescript": "5.9.2",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
